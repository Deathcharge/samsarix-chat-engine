{
  "name": "@samsarix/chat-client",
  "version": "0.3.0",
  "description": "Typed, dependency-free client for Samsarix Chat Engine",
  "type": "module",
  "sideEffects": false,
  "license": "MPL-2.0",
  "author": "Samsarix LLC <contact@samsarix.com>",
  "homepage": "https://samsarix.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deathcharge/samsarix-chat-engine.git",
    "directory": "clients/typescript"
  },
  "bugs": "https://github.com/Deathcharge/samsarix-chat-engine/issues",
  "support": "support@samsarix.com",
  "keywords": ["chat", "websocket", "typescript", "samsarix"],
  "engines": {
    "node": ">=18"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
