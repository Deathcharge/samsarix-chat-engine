# Optional. Required by the CLI before binding to a non-loopback address.
# Use a randomly generated value with at least 16 characters.
HELIX_CHAT_API_KEY=

# Persistent SQLite database location.
HELIX_CHAT_DATABASE=data/helix-chat.db

# Comma-separated exact browser origins allowed for CORS and WebSockets.
# Example: http://localhost:3000,https://chat.example.com
HELIX_CHAT_ALLOWED_ORIGINS=

# Resource and cost controls. Defaults are shown.
HELIX_CHAT_MAX_MESSAGE_CHARS=4000
HELIX_CHAT_MAX_CONNECTIONS=200
HELIX_CHAT_MAX_CONNECTIONS_PER_ROOM=100
HELIX_CHAT_MESSAGES_PER_MINUTE=60
HELIX_CHAT_MAX_ROOMS=1000
HELIX_CHAT_MAX_STORED_MESSAGES=100000
HELIX_CHAT_MAX_STORED_MESSAGES_PER_ROOM=10000
HELIX_CHAT_WS_AUTH_TIMEOUT=5
HELIX_CHAT_WS_SEND_TIMEOUT=2
HELIX_CHAT_WS_MAX_BYTES=16384
