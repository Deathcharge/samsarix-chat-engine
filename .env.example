# Optional. Required by the CLI before binding to a non-loopback address.
# Use a randomly generated value with at least 16 characters.
SAMSARIX_CHAT_API_KEY=
# Alternative for container/orchestrator secrets; do not set both forms.
# SAMSARIX_CHAT_API_KEY_FILE=/run/secrets/operator_api_key

# Optional. Enables short-lived, per-user, per-room access tokens.
# Use at least 32 random bytes and keep this operator secret out of clients.
SAMSARIX_CHAT_TOKEN_SIGNING_SECRET=
# SAMSARIX_CHAT_TOKEN_SIGNING_SECRET_FILE=/run/secrets/token_signing_secret
# Alternative verification-only mode: mount a static public JWKS and leave the
# signing secret unset. Supported algorithms are EdDSA (Ed25519) and RS256.
# SAMSARIX_CHAT_TOKEN_VERIFICATION_JWKS_FILE=/run/secrets/token-verification.jwks.json
SAMSARIX_CHAT_TOKEN_ISSUER=samsarix-chat-engine
SAMSARIX_CHAT_TOKEN_AUDIENCE=samsarix-chat
SAMSARIX_CHAT_TOKEN_MAX_LIFETIME=86400
SAMSARIX_CHAT_TOKEN_CLOCK_SKEW=30

# Persistent SQLite database location.
SAMSARIX_CHAT_DATABASE=data/samsarix-chat.db

# Guarded, unreleased v0.13 PostgreSQL preview. Comment out
# SAMSARIX_CHAT_DATABASE before selecting this backend. Prefer the URL file,
# use sslmode=verify-full outside loopback, and give every replica a unique ID.
# SAMSARIX_CHAT_STORAGE=postgres
# SAMSARIX_CHAT_POSTGRES_URL_FILE=/run/secrets/samsarix_postgres_url
# SAMSARIX_CHAT_POSTGRES_INSTANCE_ID=chat-a
# See docs/POSTGRES_PREVIEW.md for bounded pool, lease, relay, and retention settings.

# Comma-separated exact browser origins allowed for CORS and WebSockets.
# Example: http://localhost:3000,https://chat.example.com
SAMSARIX_CHAT_ALLOWED_ORIGINS=

# Resource and cost controls. Defaults are shown.
SAMSARIX_CHAT_MAX_MESSAGE_CHARS=4000
SAMSARIX_CHAT_MAX_CONNECTIONS=200
SAMSARIX_CHAT_MAX_CONNECTIONS_PER_ROOM=100
SAMSARIX_CHAT_MESSAGES_PER_MINUTE=60
SAMSARIX_CHAT_SEARCHES_PER_MINUTE=30
SAMSARIX_CHAT_MAX_ROOMS=1000
SAMSARIX_CHAT_MAX_STORED_MESSAGES=100000
SAMSARIX_CHAT_MAX_STORED_MESSAGES_PER_ROOM=10000
SAMSARIX_CHAT_MAX_READ_STATES_PER_ROOM=10000
SAMSARIX_CHAT_TYPING_EVENTS_PER_MINUTE=60
SAMSARIX_CHAT_TYPING_TIMEOUT=8
# Optional maximum message age. Leave empty to disable age-based retention.
SAMSARIX_CHAT_MESSAGE_RETENTION_DAYS=
SAMSARIX_CHAT_MAX_AUDIT_EVENTS=100000
SAMSARIX_CHAT_WS_AUTH_TIMEOUT=5
SAMSARIX_CHAT_WS_SEND_TIMEOUT=2
SAMSARIX_CHAT_WS_MAX_BYTES=16384

# Optional durable application webhook. Use HTTPS outside loopback and a
# Standard Webhooks whsec_ secret containing 24-64 random bytes.
SAMSARIX_CHAT_WEBHOOK_URL=
SAMSARIX_CHAT_WEBHOOK_SIGNING_SECRET=
# SAMSARIX_CHAT_WEBHOOK_SIGNING_SECRET_FILE=/run/secrets/webhook_signing_secret
# During zero-downtime rotation only; remove after receivers trust the new key.
SAMSARIX_CHAT_WEBHOOK_PREVIOUS_SIGNING_SECRET=
# SAMSARIX_CHAT_WEBHOOK_PREVIOUS_SIGNING_SECRET_FILE=/run/secrets/webhook_previous_signing_secret
SAMSARIX_CHAT_WEBHOOK_EVENTS=message.created,message.updated,message.deleted,member.moderation.updated
SAMSARIX_CHAT_WEBHOOK_TIMEOUT=10
SAMSARIX_CHAT_WEBHOOK_MAX_ATTEMPTS=9
SAMSARIX_CHAT_MAX_WEBHOOK_DELIVERIES=100000
# Keep false unless a trusted self-hosted endpoint intentionally uses a private network.
SAMSARIX_CHAT_WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# HELIX_CHAT_* names remain deprecated compatibility aliases.
